#!/usr/bin/env bash
# Prove a correction made it into a skill file and got committed, instead of taking it on trust.
#
#   skill-landed SKILL_DIR "PHRASE"
#
# PHRASE is a distinctive piece of the correction, exactly as it should now appear in
# SKILL_DIR/SKILL.md.
#
# Exit 0  the phrase is in SKILL.md, and SKILL.md is committed with nothing pending.
# Exit 1  the phrase is not in SKILL.md. The fix did not land.
# Exit 2  the phrase is there but SKILL.md has uncommitted changes.
# Exit 3  SKILL.md is missing, not inside a git repo, or never committed.
# Exit 64 bad arguments.
set -euo pipefail

[ $# -eq 2 ] || { echo "usage: skill-landed SKILL_DIR \"PHRASE\"" >&2; exit 64; }
skill_dir=${1%/}
phrase=$2
file="$skill_dir/SKILL.md"

[ -f "$file" ] || { echo "NOT LANDED: $file does not exist" >&2; exit 3; }

if ! grep -Fq -- "$phrase" "$file"; then
  echo "NOT LANDED: the phrase is not in $file" >&2
  exit 1
fi

dir=$(cd "$skill_dir" && pwd -P)
if ! git -C "$dir" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  echo "NOT COMMITTED: $file is not inside a git repo, so nothing can prove the fix survives" >&2
  exit 3
fi

if ! git -C "$dir" ls-files --error-unmatch SKILL.md >/dev/null 2>&1; then
  echo "NOT COMMITTED: $file is not tracked by git" >&2
  exit 3
fi

if [ -n "$(git -C "$dir" status --porcelain -- SKILL.md)" ]; then
  echo "NOT COMMITTED: $file has uncommitted changes. Commit them, then re-run." >&2
  exit 2
fi

echo "LANDED: $file"
git -C "$dir" log -1 --format='last commit %h %ad %s' --date=short -- SKILL.md
